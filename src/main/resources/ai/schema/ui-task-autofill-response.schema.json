{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuroflowplanner.local/schema/ai/ui-task-autofill-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "description": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "string",
      "minLength": 1
    },
    "complexity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    }
  },
  "required": [
    "description",
    "tags",
    "complexity"
  ]
}
