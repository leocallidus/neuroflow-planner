{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuroflowplanner.local/schema/ai/models-response.schema.json",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "data": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/modelEntry"
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/modelEntry"
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "data"
      ]
    },
    {
      "required": [
        "models"
      ]
    }
  ],
  "$defs": {
    "modelEntry": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "id"
          ]
        },
        {
          "required": [
            "name"
          ]
        }
      ]
    }
  }
}
