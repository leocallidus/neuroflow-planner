{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuroflowplanner.local/schema/ai/chat-response.schema.json",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "message": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "content": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "content"
      ]
    },
    "content": {
      "type": "string",
      "minLength": 1
    },
    "response": {
      "type": "string",
      "minLength": 1
    },
    "choices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "message": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "content": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "content"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "anyOf": [
          {
            "required": [
              "message"
            ]
          },
          {
            "required": [
              "text"
            ]
          }
        ]
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "choices"
      ]
    },
    {
      "required": [
        "message"
      ]
    },
    {
      "required": [
        "content"
      ]
    },
    {
      "required": [
        "response"
      ]
    }
  ]
}
