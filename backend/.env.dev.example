NEUROFLOW_ENVIRONMENT=dev
NEUROFLOW_API__HOST=0.0.0.0
NEUROFLOW_API__PORT=8000
NEUROFLOW_API__RELOAD=true
NEUROFLOW_LOGGING__LEVEL=DEBUG
NEUROFLOW_LOGGING__JSON_LOGS=false
NEUROFLOW_SECURITY__JWT_SECRET=dev-only-change-me-secret-at-least-32b
NEUROFLOW_SECURITY__JWT_ALGORITHM=HS256
NEUROFLOW_SECURITY__JWT_ISSUER=neuroflow-cloud-backend
NEUROFLOW_SECURITY__JWT_AUDIENCE=neuroflow-desktop
NEUROFLOW_SECURITY__ACCESS_TOKEN_TTL_MINUTES=30
NEUROFLOW_SECURITY__REFRESH_TOKEN_TTL_DAYS=30
NEUROFLOW_SECURITY__REFRESH_TOKEN_PEPPER=dev-only-refresh-pepper-at-least-32b
NEUROFLOW_DATABASE__URL=postgresql+asyncpg://neuroflow:neuroflow@127.0.0.1:5433/neuroflow_sync
NEUROFLOW_DATABASE__ECHO=false
NEUROFLOW_DATABASE__POOL_SIZE=5
NEUROFLOW_DATABASE__MAX_OVERFLOW=10
NEUROFLOW_DATABASE__CONNECT_TIMEOUT_SECONDS=5
NEUROFLOW_DATABASE__READINESS_TIMEOUT_SECONDS=2
NEUROFLOW_DATABASE__CHECK_ON_STARTUP=true
