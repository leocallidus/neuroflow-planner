NEUROFLOW_ENVIRONMENT=prod
NEUROFLOW_API__HOST=0.0.0.0
NEUROFLOW_API__PORT=8000
NEUROFLOW_API__RELOAD=false
NEUROFLOW_LOGGING__LEVEL=INFO
NEUROFLOW_LOGGING__JSON_LOGS=true
NEUROFLOW_SECURITY__JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_OF_32_BYTES_OR_MORE
NEUROFLOW_SECURITY__JWT_ALGORITHM=HS256
NEUROFLOW_SECURITY__JWT_ISSUER=neuroflow-cloud-backend
NEUROFLOW_SECURITY__JWT_AUDIENCE=neuroflow-desktop
NEUROFLOW_SECURITY__ACCESS_TOKEN_TTL_MINUTES=30
NEUROFLOW_SECURITY__REFRESH_TOKEN_TTL_DAYS=30
NEUROFLOW_SECURITY__REFRESH_TOKEN_PEPPER=REPLACE_WITH_SEPARATE_RANDOM_PEPPER_OF_32_BYTES_OR_MORE
NEUROFLOW_DATABASE__URL=postgresql+asyncpg://USER:PASSWORD@HOST:5433/neuroflow_sync
NEUROFLOW_DATABASE__ECHO=false
NEUROFLOW_DATABASE__POOL_SIZE=20
NEUROFLOW_DATABASE__MAX_OVERFLOW=40
NEUROFLOW_DATABASE__CONNECT_TIMEOUT_SECONDS=5
NEUROFLOW_DATABASE__READINESS_TIMEOUT_SECONDS=3
NEUROFLOW_DATABASE__CHECK_ON_STARTUP=true
